MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=artcanvas
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Payment Gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Email Dispatch Configuration
# Option 1: Resend (Recommended for Next.js & Vercel serverless)
RESEND_API_KEY=
EMAIL_FROM=ArtCanvas Studio <onboarding@resend.dev>

# Option 2: SMTP / Gmail (Alternative provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ArtCanvas Studio <orders@artcanvas.com>

SEED_SECRET=optional-local-seed-secret
